# Server Port
PORT=3000

# Optional: Path to Firebase Service Account JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Optional: Raw Firebase Service Account JSON (Recommended for cloud deployments like Render, Railway, Heroku)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}
